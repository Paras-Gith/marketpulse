# --- App ---
APP_NAME=MarketPulse AI
# Public URL of the app. PayPal redirects buyers back here, so use your public https URL
# (Codespaces forwarded port, Render URL, ngrok...) when testing payments end to end.
BASE_URL=http://localhost:8000
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///./marketpulse.db

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled in by:  python -m scripts.setup_paypal
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PRO_PRICE_USD=5.00
BRIEF_PRICE_USD=1.00

# --- AI (free key at console.groq.com). Leave empty to use keyword fallbacks. ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- News ---
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=300
FEED_DELAY_MINUTES=30
# Sample stories so the app is never empty. Set false to show only live feeds.
SEED_DEMO=true
